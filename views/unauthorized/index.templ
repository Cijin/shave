package unauthorized

import (
	"shave/views/components/button"
	"shave/views/components/icon"
	"shave/views/layouts"
)

templ Index() {
	@layouts.Error() {
		<section class="flex min-h-svh w-full items-center justify-center p-6 md:p-10">
			<div class="text-center space-y-6 max-w-md">
				@UnauthorizedIcon()
				@UnauthorizedContent()
				@UnauthorizedActions()
			</div>
		</section>
	}
}

templ UnauthorizedIcon() {
	<div class="relative inline-flex">
		<div class="absolute inset-0 bg-red-500/10 rounded-full"></div>
		<div class="relative rounded-full bg-red-100 dark:bg-red-900/20 p-6">
			@icon.Lock(icon.Props{
				Size:  48,
				Class: "text-red-600 dark:text-red-500",
			})
		</div>
	</div>
}

templ UnauthorizedContent() {
	<div class="space-y-2">
		<h2 class="text-2xl font-semibold tracking-tight">Access Denied</h2>
		<p class="text-muted-foreground">
			You don't have permission to access this resource. Please request partner/owner for permission.
		</p>
	</div>
}

templ UnauthorizedActions() {
	<div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
		@button.Button(button.Props{
			Variant: button.VariantOutline,
			Attributes: templ.Attributes{
				"onclick": "window.history.back()",
			},
		}) {
			<span class="flex items-center gap-2">
				@icon.ArrowLeft(icon.Props{
					Size: 16,
				})
				Go back
			</span>
		}
		<a href="/">
			@button.Button(button.Props{}) {
				<span class="flex items-center gap-2">
					@icon.House(icon.Props{
						Size: 16,
					})
					Home
				</span>
			}
		</a>
	</div>
}
