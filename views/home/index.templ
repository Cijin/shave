package home

import (
	"shave/pkg/data"
	"shave/views/layouts"
	"shave/views/components/card"
	"shave/views/components/button"
	"shave/views/components/icon"
)

templ Index() {
	@layouts.Base(data.SessionUser{Email: ""}) {
		<main class="container mx-auto md:px-6 py-12">
			<div class="max-w-md mx-auto">
				@card.Card(card.Props{
					Class: "w-full",
				}) {
					@card.Header() {
						@card.Title() {
							<div class="flex items-center gap-2">
								@icon.Home(icon.Props{Size: 24})
								<span>Welcome</span>
							</div>
						}
						@card.Description() {
							Get started with your dashboard
						}
					}
					@card.Content() {
						<div class="space-y-4">
							<p class="text-muted-foreground">
								Please login to access your personalized dashboard and manage your tasks.
							</p>
							<div class="flex justify-center">
								<a href="/login/google" aria-label="login with google">
									@button.Button(button.Props{
										Variant: button.VariantDefault,
										Size:    button.SizeLg,
										Class:   "flex items-center gap-2",
									}) {
										<img width="20" height="20" src="/assets/google-icon.svg" alt="Google"/>
										<span>Login with Google</span>
									}
								</a>
							</div>
						</div>
					}
				}
			</div>
		</main>
	}
}

templ SessionedHome(u data.SessionUser) {
	@layouts.Base(u) {
		<main class="container mx-auto md:px-6 py-12">
			<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
				@card.Card(card.Props{
					Class: "w-full",
				}) {
					@card.Header() {
						@card.Title() {
							<div class="flex items-center gap-2">
								@icon.User(icon.Props{Size: 24})
								<span>Welcome back, { u.Name }!</span>
							</div>
						}
						@card.Description() {
							Your dashboard overview
						}
					}
					@card.Content() {
						<div class="space-y-4">
							<p class="text-muted-foreground">
								You're successfully logged in. Start managing your tasks and projects.
							</p>
							<div class="flex gap-2">
								<a href="/todo">
									@button.Button(button.Props{
										Variant: button.VariantDefault,
										Size:    button.SizeSm,
										Class:   "flex items-center gap-2",
									}) {
										@icon.Check(icon.Props{Size: 16})
										<span>View Tasks</span>
									}
								</a>
								<a href="/permissions">
									@button.Button(button.Props{
										Variant: button.VariantOutline,
										Size:    button.SizeSm,
										Class:   "flex items-center gap-2",
									}) {
										@icon.Settings(icon.Props{Size: 16})
										<span>Settings</span>
									}
								</a>
							</div>
						</div>
					}
				}
				@card.Card(card.Props{
					Class: "w-full",
				}) {
					@card.Header() {
						@card.Title() {
							<div class="flex items-center gap-2">
								@icon.Activity(icon.Props{Size: 24})
								<span>Quick Stats</span>
							</div>
						}
					}
					@card.Content() {
						<div class="space-y-3">
							<div class="flex justify-between items-center">
								<span class="text-sm text-muted-foreground">Tasks Completed</span>
								<span class="font-semibold">0</span>
							</div>
							<div class="flex justify-between items-center">
								<span class="text-sm text-muted-foreground">Active Projects</span>
								<span class="font-semibold">0</span>
							</div>
							<div class="flex justify-between items-center">
								<span class="text-sm text-muted-foreground">Account Status</span>
								<span class="text-green-600 font-semibold">Active</span>
							</div>
						</div>
					}
				}
				@card.Card(card.Props{
					Class: "w-full",
				}) {
					@card.Header() {
						@card.Title() {
							<div class="flex items-center gap-2">
								@icon.Zap(icon.Props{Size: 24})
								<span>Quick Actions</span>
							</div>
						}
					}
					@card.Content() {
						<div class="space-y-2">
							<a href="/todo" class="block">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "w-full justify-start gap-2",
								}) {
									@icon.Plus(icon.Props{Size: 16})
									<span>Create New Task</span>
								}
							</a>
							<a href="#" class="block">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "w-full justify-start gap-2",
								}) {
									@icon.FolderOpen(icon.Props{Size: 16})
									<span>Browse Projects</span>
								}
							</a>
							<a href="#" class="block">
								@button.Button(button.Props{
									Variant: button.VariantGhost,
									Size:    button.SizeSm,
									Class:   "w-full justify-start gap-2",
								}) {
									@icon.BarChart(icon.Props{Size: 16})
									<span>View Analytics</span>
								}
							</a>
						</div>
					}
				}
			</div>
		</main>
	}
}
